{
  "name": "echo-coding-harness",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight, local-first autonomous coding agent built from scratch.",
  "type": "module",
  "bin": {
    "echo-harness": "./dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "dist/web"
  ],
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "accept:web-provider": "node scripts/accept-web-provider.mjs",
    "accept:p3-pdf": "node scripts/accept-p3-pdf-demo.mjs",
    "build": "pnpm build:node && pnpm build:web",
    "build:node": "node scripts/clean-node-dist.mjs && tsup",
    "build:web": "vite build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm smoke && pnpm scan",
    "dev": "tsx src/cli.ts",
    "dev:web": "vite",
    "eval": "vitest run tests/evals",
    "eval:offline": "node scripts/eval-offline.mjs",
    "p3:demo:baseline": "node scripts/p3-pdf-demo-evidence.mjs baseline",
    "p3:demo:reset": "node scripts/p3-pdf-demo-reset.mjs",
    "p3:demo:verify": "node scripts/p3-pdf-demo-evidence.mjs verify",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.json\" \"*.js\" \"*.ts\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.json\" \"*.js\" \"*.ts\" \".github/**/*.yml\"",
    "lint": "eslint . --max-warnings 0",
    "scan": "pnpm scan:secrets && pnpm scan:identity && pnpm scan:self-test && pnpm scan:web-artifacts",
    "scan:identity": "node scripts/scan-identity.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:self-test": "node scripts/scan-secrets.mjs --self-test && node scripts/scan-identity.mjs --self-test",
    "scan:web-artifacts": "node scripts/scan-web-artifacts.mjs --self-test",
    "smoke": "node scripts/smoke-cli.mjs && node scripts/smoke-provider.mjs && node scripts/smoke-artifact.mjs && node scripts/smoke-web-artifact.mjs && node scripts/smoke-web-isolated-artifact.mjs",
    "smoke:artifact": "node scripts/smoke-artifact.mjs",
    "smoke:web-artifact": "node scripts/smoke-web-artifact.mjs",
    "smoke:web-isolated-artifact": "node scripts/smoke-web-isolated-artifact.mjs",
    "smoke:demo": "node scripts/eval-demo-smoke.mjs",
    "smoke:provider": "node scripts/smoke-provider.mjs",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:web": "vitest run tests/unit/web tests/integration/web",
    "test:web:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "10.1.2",
    "commander": "15.0.0",
    "fastify": "5.12.1",
    "openai": "6.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
